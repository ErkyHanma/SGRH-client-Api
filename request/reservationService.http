###
# Add a new service to a reservation 
POST http://localhost:4000/api/client/reservationService/ HTTP/1.1
Content-Type: application/json

{
  "reservationId": 4,
  "serviceId": 2
}

###
# Remove a service from a reservation 
POST http://localhost:4000/api/client/reservationService/delete HTTP/1.1
Content-Type: application/json

{
  "reservationId": 4,
  "serviceId":2
}
