###
# Get all reservations 
GET http://localhost:4000/api/client/reservation

###
# Get reservation by ID 

GET http://localhost:4000/api/client/reservation/5

###
# Get all reservation by client ID 
GET http://localhost:4000/api/client/reservation/user/3

###
# Create a new reservation 
POST http://localhost:4000/api/client/reservation HTTP/1.1
Content-Type: application/json

{
    "clientId": 2,
    "roomId": 4,
    "startDate": "2075-04-01",
    "endDate": "2075-04-03",
    "status": "Pending",
    "guestCount": 4,
    "paymentAmount": "200"

}
  
###
# Update a reservation 
PUT http://localhost:4000/api/client/reservation/8 HTTP/1.1
Content-Type: application/json

{
    "clientId": 2,
    "roomId": 3,
    "startDate": "2075-04-01",
    "endDate": "2075-04-03",
    "status": "Pending",
    "guestCount": 1,
    "paymentAmount": "200"

}


###
# Delete a reservation 
DELETE http://localhost:4000/api/client/reservation/8

###
# Check room availabily for given date
POST http://localhost:4000/api/client/reservation/available HTTP/1.1
Content-Type: application/json

{
  "roomId": 6,
  "startDate": "2025-04-01",
  "endDate": "2025-04-03"
}