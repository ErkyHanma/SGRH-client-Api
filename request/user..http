# Check API health
GET http://localhost:4000/api/client/health

###
# Get all users 
GET http://localhost:4000/api/client/user

###
# Get user by ID 
GET http://localhost:4000/api/client/user/7

###
# Get user by email 
GET http://localhost:4000/api/client/user/email/sarah.wilson@email.com

###
# Add a new user 
POST http://localhost:4000/api/client/user HTTP/1.1
Content-Type: application/json

{
  "firstName": "Juan",
  "lastName": "Mota",
  "email": "juan@example.com",
  "passwordHash": "hashed_password_here",
  "roleId": 3,
  "phone": "+1-555-1234",
  "address": "123 Main St, City, Country"
}

###
# Update user by ID 
PUT http://localhost:4000/api/client/user/11 HTTP/1.1
Content-Type: application/json

{
  "firstName": "Juan",
  "lastName": "steven",
  "email": "juan.doe@example.com",
  "passwordHash": "hashed_password_here",
  "roleId": 3,
  "phone": "+1-555-1234",
  "address": "123 Main St, City, Country"
}

###
# Delete user by ID 
DELETE http://localhost:4000/api/client/user/11 HTTP/1.1
